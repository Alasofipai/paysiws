<div class="login-signin">
    <div class="mb-20">
        <h3 class="opacity-40 font-weight-normal">Backoffice</h3>
        <p class="opacity-40">Ingresa tus datos para iniciar sesi&#xF3;n:</p>
    </div>
    <form id="account" method="post" data-ajax="true">
        <input asp-asp-for="Input.IsPostBack" value="true" hidden />
        <input value="Paywise" hidden type="text" id="Input_AliasOrganizacon" name="Input.AliasOrganizacon" />
        <input value="" hidden type="text" id="Input_Token" name="Input.Token" />
        <div class="form-group">
            <input class="form-control h-auto text-white bg-white-o-5 rounded-pill border-0 py-4 px-8" type="text" placeholder="Usuario" autocomplete="off" data-val-required="El campo usuario es requerido" data-val="true" id="Input_UserName" name="Input.UserName" value="" />
            <span class="text-danger text-right field-validation-valid" data-valmsg-for="Input.UserName" data-valmsg-replace="true"></span>
        </div>
        <div class="form-group">
            <input class="form-control h-auto text-white bg-white-o-5 rounded-pill border-0 py-4 px-8" type="password" placeholder="Contrase&#xF1;a" data-val-required="La contrase&#xF1;a es incorrecta." data-val="true" id="Input_Password" name="Input.Password" />
            <span class="text-danger text-right field-validation-valid" data-valmsg-for="Input.Password" data-valmsg-replace="true"></span>
        </div>

        <div class="modal fade" id="HoldersUserModal" tabindex="-1" role="dialog" aria-labelledby="HoldersUserModalLabel" aria-hidden="true">

<div id="sessionExpired" class="sessionExp">
    <div class="sessionExp-content">
        <p>Por seguridad, tu sesión ha expirado</p>
        <p>Vuelve a iniciar sesión</p>
        <button id="sessionExpBtn" class="btn btn-pill btn-secondary">ACEPTAR</button>

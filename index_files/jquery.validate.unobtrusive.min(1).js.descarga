    <script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.17.0/jquery.validate.min.js" crossorigin="anonymous" integrity="sha384-rZfj/ogBloos6wzLGpPkkOr/gpkBNLZ6b6yLy4o+ok+t/SAKlL5mvXLr0OXNi1Hp">
    </script>
<script>(window.jQuery && window.jQuery.validator||document.write("\u003Cscript src=\u0022/Identity/lib/jquery-validation/dist/jquery.validate.min.js\u0022 crossorigin=\u0022anonymous\u0022 integrity=\u0022sha384-rZfj/ogBloos6wzLGpPkkOr/gpkBNLZ6b6yLy4o\u002Bok\u002Bt/SAKlL5mvXLr0OXNi1Hp\u0022\u003E\u003C/script\u003E"));</script>
    <script src="https://ajax.aspnetcdn.com/ajax/jquery.validation.unobtrusive/3.2.9/jquery.validate.unobtrusive.min.js" crossorigin="anonymous" integrity="sha384-ifv0TYDWxBHzvAk2Z0n8R434FL1Rlv/Av18DXE43N/1rvHyOG4izKst0f2iSLdds">
    </script>
<script>(window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive||document.write("\u003Cscript src=\u0022/Identity/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js\u0022 crossorigin=\u0022anonymous\u0022 integrity=\u0022sha384-ifv0TYDWxBHzvAk2Z0n8R434FL1Rlv/Av18DXE43N/1rvHyOG4izKst0f2iSLdds\u0022\u003E\u003C/script\u003E"));</script>


    <script type="text/javascript">
        var isSessionValid = 'False'.toLowerCase() === 'true';
        $(document).ready(function () {

            const modal = document.getElementById('sessionExpired');
            const closeButton = document.getElementById('sessionExpBtn');
            const notificationModal = document.getElementById('notificationAlert');
            const notificationCloseButton = document.getElementById('notificationAlertBtn');
            notificationModal.style.display = 'flex';

            if (!isSessionValid) {
                modal.style.display = 'flex';
            }

            closeButton.addEventListener('click', () => {
                modal.style.display = 'none';
            });
            
            let userId = null;
            
            notificationCloseButton.addEventListener('click', (e) => {
                e.preventDefault();
                notificationModal.style.display = 'none';
            });

            $('#Input_IdHolder').select2({

                placeholder: "Seleccionar...",
                templateResult: function (data) {
                    if (!data.element) {
                        return data.text;
                    }
                    var $element = $(data.element);
                    var $wrapper = $('<span></span>');
                    $wrapper.addClass($element[0].className);
                    $wrapper.text(data.text);
                    return $wrapper;
                }
            });

            $("#btnGuardarModalRegistroToken").click((e) => {
                e.preventDefault(); // Prevent the default form submission
                $("#modalRegistroToken").modal("hide");
                const token = $("#transaction-token").val();
                $("#Input_Token").val(`${token}`);
                $("#transaction-token").val("");
                getHolders();
            });

            $("#btnReenviarToken").click(function (e) {
                resendToken()
            });
            
            function validateToken() {
                $("#modalRegistroToken").modal("show");
                
            }
            
            function resendToken() {
                $.ajax({
                    url: "/Token/Resend",
                    method: "POST",
                    data: $('form[data-ajax="true"]').serialize(),
                    contentType: 'application/x-www-form-urlencoded',
                    success: function (data) {
                        $('#message').html('<div class="alert alert-success">Token enviado.</div>');
                    },
                    error: function (error) {
                        if (error.status == 200) {
                            $('#message').html('<div class="alert alert-success">Token enviado.</div>');
                        } else {
                            $('#message').html('<div class="alert alert-danger">Error al enviar token.</div>');
                        }
                       
                    }
                });
            }
        
            $('form[data-ajax="true"]').submit(function (event) {
                cleanError();
                event.preventDefault(); // Prevent the default form submission

                var form = $(this);
                var url = '/Identity/Account/Login?handler=ValidateCredentials'; // Adjust this to the correct URL

                $.ajax({
                    type: "POST",
                    url: url,
                    data: form.serialize(),
                    success: function (response) {
                        console.log('validateCredentials:');
                        console.log(response);
                        if (response.success) {
                            userId = response.userId;
                            validateToken();
                        }
                        else {
                            $(form).attr('action', '/Identity/Account/Login?handler=OnPost');
                            $(form).off('submit').submit();
                        }
                    },
                    error: function (error) {
                        const { responseJSON } = error ?? {};
                         const { message, accessFailedCount } = responseJSON ?? {};
                        
                        if (message) {
                            showError(message);
                            // if accessFailedCount is greater than 1, show captcha
                            if (accessFailedCount >= 1 && isLoginRecaptchaEnabled) {
                                grecaptcha.reset();
                                $(".captcha-wrapper").show();
                                //disable submit button
                                $('button[type="submit"]').prop("disabled", true);
                            }
                        } else {
                            $('#message').html('<div class="alert alert-danger">An error occurred. Please try again.</div>');
                        }
                    }
                });
            });

            function getHolders() {
                
                const form = $('#account');
                //const formData = new FormData(form);
                var url = '/Identity/Account/Login?handler=Holders';
                $.ajax({
                    type: "POST",
                    url: url,
                    data: form.serialize(),
                    success: function (res) {
                        if (res.error) {
                            toastr.error(res.errorDescription);
                            return;
                        }
                        $("#Input_IdHolder").append('<option value=""></option>');
                        // Populate modal with available holders
                        $.each(res.result, function (i, holder) {
                            if (holder.nivel == 1) {
                                $("#Input_IdHolder").append('<option class="nivel1" value="' + holder.id + '">' + holder.nombre + '</option>');
                            }
                            if (holder.nivel == 2) {
                                $("#Input_IdHolder").append('<option class="nivel2" value="' + holder.id + '">' + holder.nombre + '</option>');
                            }
                        });

                        $('#HoldersUserModal').modal('show');
                        // Event when select holder
                        $('#Input_IdHolder').on('change', function () {
                            $('#HoldersUserModal').modal('hide');
                            // Assign holder to input
                            $("#Input_IdHolder").val($(this).val());
                            $("form").unbind('submit').submit();
                        });
                    },
                    error: function (ex) {
                        toastr.error("Ocurri&#xF3; un error al obtener la informaci&#xF3;n.", ex);
                    }
                });
            }
            
            function showError(message) {
                const userName = document.querySelector("#Input_UserName").nextElementSibling;
                userName.innerHTML = message;
                userName.classList.remove('field-validation-valid');
                userName.classList.add('field-validation-error');
                
            }
            
            function cleanError() {
                const userName = document.querySelector("#Input_UserName").nextElementSibling;
                userName.innerHTML = '';
                userName.classList.add('field-validation-valid');
                userName.classList.remove('field-validation-error');
                
            }
        });
    </script>

    <script>
        const LoginResources = {
            UserRequired: "El campo usuario es requerido",
            PasswordRequired: "La contrase&#xF1;a es incorrecta.",
            HolderRequired: "Debe seleccionar un holder",
            Select: "Seleccionar..."
        };
        let OrganizationId = 1;
    </script>

    <!--end::Page Scripts-->
